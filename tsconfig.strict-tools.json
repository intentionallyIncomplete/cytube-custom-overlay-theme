{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "scripts/root-ownership.ts",
    "tests/unit/**/*.vitest.ts",
    "vitest.config.ts",
    "src/lib/style-paths.js",
    "src/lib/cdn-deploy.js",
    "src/lib/channel-config.js",
    "src/lib/theme-admin-blocks.js",
    "src/lib/asset-paths.ts",
    "src/lib/escape-html.ts",
    "src/lib/can-load-admin-bundle.ts",
    "src/lib/apply-chat-typography.ts",
    "src/lib/defer-feature-open.ts",
    "src/btfw-globals.d.ts",
    "src/lib/stack-core.ts",
    "src/modules/stack/stack-poll.ts",
    "src/lib/btfw-constants.js"
  ],
  "exclude": ["dist", "node_modules", "src/workers"]
}
