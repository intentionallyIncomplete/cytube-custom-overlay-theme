{
  "name": "quiglysmovies",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_REFRESH_TOKEN",
      "CRYPTO_BASE_KEY",
      "HMAC_BASE_KEY",
      "GOOGLE_CLIENT_SECRET_FOR_LOGIN"
    ]
  }
}
